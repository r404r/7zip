(version 1)
(deny default)
(allow process-exec)
(allow sysctl-read)
(allow file-read* (subpath "/usr"))
(allow file-read* (subpath "/System"))
(allow file-read* (subpath "/Library"))
(allow file-read* (subpath "/Users/runner/work/_temp/b04/sandbox"))
(allow file-write* (subpath "/Users/runner/work/_temp/b04/sandbox/work"))
