+def _telegram_zh_message(ev: Any, n: "_KanbanNotification") -> str:
+    """Localize presentation only; payloads and the existing wake handoff stay intact."""
+    timeout = int(_payload(ev, "limit_seconds") or 0) if ev.kind == "timed_out" else 0
+    descriptions = {
+        "completed": f"✔ {n.head} 已完成（done）— {n.title}",
+        "blocked": f"⏸ {n.head} 已阻塞（BLOCKED），请查看原因。",
+        "gave_up": f"✖ {n.head} 多次启动失败，已停止重试（gave_up）。",
+        "crashed": f"✖ {n.head} 执行进程已退出（crashed）；dispatcher 将重试。",
+        "timed_out": f"⏱ {n.head} 已超时（timed_out，max_runtime={timeout}s）；将重试。",
+        "status": f"🔄 {n.head} 状态变更 → {_payload(ev, 'status') or ''}",
+        "review_requested": f"👀 {n.head} 等待独立审查（review_requested）— {n.title}",
+        "changes_requested": f"🛑 {n.head} 审查要求修改（changes_requested/BLOCK）；请在同一任务中修复并重新审查。",
+        "block_loop_detected": f"🛑 {n.head} 已转入 TRIAGE，需要人工决策。",
+    }
+    message = "中文解释:\n" + descriptions[ev.kind]
+    payload = ev.payload or {}
+    if ev.kind == "changes_requested":
+        reviewer = _safe_review_reason(payload.get("reviewer"), 48)
+        implementer = _safe_review_reason(payload.get("implementer"), 48)
+        if reviewer:
+            message += f"\n审查者 @{reviewer}"
+        if implementer:
+            message += f" → 实施者 @{implementer}"
+        # Keep the pre-existing review disclosure boundary. Do not label the
+        # sanitized/mobile excerpt as exact compiler or shell output.
+        reason = _safe_review_reason(payload.get("reason"))
+        if reason:
+            message += "\n以下审查意见保留现有脱敏与长度限制。\n原始信息:\n" + reason
+        return message
+    if ev.kind == "block_loop_detected" and _payload(ev, "recurrences"):
+        message += f"\n同一原因已阻塞 {_payload(ev, 'recurrences')} 次。"
+    evidence_fields = {
+        "completed": ("summary", 200), "review_requested": ("summary", 200),
+        "blocked": ("reason", 160), "gave_up": ("error", 200),
+        "block_loop_detected": ("reason", 160),
+    }
+    field = evidence_fields.get(ev.kind)
+    if field:
+        key, limit = field
+        value = _payload(ev, key)
+        if not value and ev.kind == "completed" and n.task:
+            value = n.task.result
+            limit = 160
+        if value:
+            raw = str(value)
+            excerpt = _first_line(raw, limit) if ev.kind == "completed" else raw[:limit]
+            if excerpt != raw:
+                message += "\n以下为原文摘录；完整信息见任务记录。"
+            message += "\n原始信息:\n" + excerpt
+    return message
+
